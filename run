#!/usr/bin/env bash

set -euo pipefail

EXEC=""
TARGET="buildScript"
PARAMS=()

for e in "$@"; do
  TARGET="$TARGET/$e"
  PARAMS+=("$e")
  if [ -x "${TARGET}.sh" ]; then
    EXEC="${TARGET}.sh"
    PARAMS=()
  fi
done

if [ -z "$EXEC" ]; then
  echo "No script found under buildScript/ for: $*" >&2
  exit 1
fi

echo ">> $EXEC"
exec "$EXEC" "${PARAMS[@]}"
