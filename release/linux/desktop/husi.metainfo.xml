<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metadata, rendered by release/linux/package.sh into
  usr/share/metainfo/. Software centres read it, and so do AppImage installers:
  AppManager falls back to the first <release version> and the first untranslated
  <summary> when the desktop entry carries no X-AppImage-Version. Keep the
  untranslated variants first for that reason.
-->
<component type="desktop-application">
  <id>__HUSI_PACKAGE_NAME__</id>
  <launchable type="desktop-id">__HUSI_PACKAGE_NAME__.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>__HUSI_APP_NAME__</name>
  <name xml:lang="zh_CN">__HUSI_APP_NAME_ZH_CN__</name>
  <name xml:lang="zh_TW">__HUSI_APP_NAME_ZH_TW__</name>

  <summary>__HUSI_APP_DESCRIPTION__</summary>
  <summary xml:lang="zh_CN">__HUSI_APP_DESCRIPTION_ZH_CN__</summary>
  <summary xml:lang="zh_TW">__HUSI_APP_DESCRIPTION_ZH_TW__</summary>

  <description>
    <p>__HUSI_APP_FULL_DESCRIPTION__</p>
    <p xml:lang="zh_CN">__HUSI_APP_FULL_DESCRIPTION_ZH_CN__</p>
    <p xml:lang="zh_TW">__HUSI_APP_FULL_DESCRIPTION_ZH_TW__</p>
  </description>

  <developer id="__HUSI_PACKAGE_NAME__">
    <name>__HUSI_MAINTAINER__</name>
  </developer>

  <url type="homepage">__HUSI_APP_URL__</url>
  <url type="bugtracker">__HUSI_APP_URL__/issues</url>

  <categories>
    <category>Network</category>
  </categories>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="__HUSI_VERSION_NAME__" date="__HUSI_RELEASE_DATE__"/>
  </releases>
</component>
